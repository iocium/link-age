{
  "name": "@iocium/link-age",
  "version": "0.0.1",
  "description": "A powerful enrichment tool for estimating the creation time or first-seen date of domains and URLs, aiding phishing detection and threat analysis.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "link-age": "dist/cli.js"
  },
  "scripts": {
    "build": "bunx --bun tsup",
    "build:browser": "bunx --bun tsup --config tsup.browser.config.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "docs": "bunx --bun typedoc"
  },
  "keywords": [
    "domain",
    "url",
    "threat-intelligence",
    "first-seen",
    "phishing",
    "reputation",
    "estimation",
    "intel",
    "iocium"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/iocium/link-age"
  },
  "author": "iocium",
  "license": "MIT",
  "dependencies": {
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "ora": "^9.4.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typedoc": "^0.28.7",
    "typescript": "6.0.3"
  }
}
